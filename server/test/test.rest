###############################################
# AUTH ROUTES
###############################################

### Register New User
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "yassine@example.com",
  "password": "password123",
  "firstName": "yassine",
  "lastName": "ben"
}

### Login User
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "yassine@example.com",
  "password": "password123"
}

### Get Current User Profile
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{token}}

### Update User Profile
PUT {{baseUrl}}/api/v1/auth/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "lastName": "Elmardi"
}

### Change Password
PUT {{baseUrl}}/api/v1/auth/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "password123",
  "newPassword": "newpassword456"
}

### Logout
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{token}}

### Add Product to Wishlist
POST {{baseUrl}}/api/v1/auth/wishlist/{{productId}}
Authorization: Bearer {{token}}

### Remove Product from Wishlist
DELETE {{baseUrl}}/api/v1/auth/wishlist/{{productId}}
Authorization: Bearer {{token}}

### Get User Wishlist
GET {{baseUrl}}/api/v1/auth/wishlist
Authorization: Bearer {{token}}

###############################################
# PRODUCT ROUTES
###############################################

### Get All Products (Basic)
GET {{baseUrl}}/api/v1/products

### Get Products with Pagination
GET {{baseUrl}}/api/v1/products?page=1&limit=3

### Get Products with Search
GET {{baseUrl}}/api/v1/products?search=moisturizer

### Get Products with Category Filter
GET {{baseUrl}}/api/v1/products?category=skincare

### Get Products with Price Range Filter
GET {{baseUrl}}/api/v1/products?minPrice=100&maxPrice=180

### Get Products with Multiple Filters
GET {{baseUrl}}/api/v1/products?category=skincare&brand=CeraVe&minPrice=10&maxPrice=100&minRating=4&inStock=true&page=1&limit=12

### Get Products with Search and Filters Combined
GET {{baseUrl}}/api/v1/products?search=serum&category=skincare&minPrice=20&maxPrice=100&page=1&limit=10

### Get Products Sorted by Price (Ascending)
GET {{baseUrl}}/api/v1/products?sortBy=price&order=asc

### Get Products Sorted by Price (Descending)
GET {{baseUrl}}/api/v1/products?sortBy=price&order=desc

### Get Products Sorted by Newest First
GET {{baseUrl}}/api/v1/products?sortBy=createdAt&order=desc

### Get Products by Multiple Brands
GET {{baseUrl}}/api/v1/products?brand=CeraVe,MAC,OGX

### Get In-Stock Products Only
GET {{baseUrl}}/api/v1/products?inStock=true

### Get Search Suggestions (Autocomplete)
GET {{baseUrl}}/api/v1/products/search/suggestions?q=moist&limit=5

### Get Featured Products
GET {{baseUrl}}/api/v1/products/featured?limit=8

### Get Products by Category
GET {{baseUrl}}/api/v1/products/category/haircare?page=1&limit=12

### Get Available Filters
GET {{baseUrl}}/api/v1/products/filters/available

### Get Product Count by Category
GET {{baseUrl}}/api/v1/products/stats/category-count

### Get Single Product
GET {{baseUrl}}/api/v1/products/{{productId}}

### Get Related Products
GET {{baseUrl}}/api/v1/products/{{productId}}/related?limit=4




###############################################
# ORDER ROUTES
###############################################

### Create New Order
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 2,
      "price": 14.99
    }
  ],
  "shippingAddress": {
    "street": "123 Main Street",
    "city": "New York",
    "state": "NY",
    "zipCode": "10001",
    "country": "USA",
    "isDefault": true
  },
  "paymentMethod": "credit_card"
}

### Get All Orders (User sees own, Admin sees all)
GET {{baseUrl}}/api/v1/orders
Authorization: Bearer {{token}}

### Get Single Order
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{token}}

### Cancel Order
PUT {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}

### Delete Order (Admin Only)
DELETE {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{token}}

### Get Orders by User ID (Admin Only)
GET {{baseUrl}}/api/v1/orders/user/USER_ID_HERE
Authorization: Bearer {{token}}

### Get Order Invoice
GET {{baseUrl}}/api/v1/orders/{{orderId}}/invoice
Authorization: Bearer {{token}}

